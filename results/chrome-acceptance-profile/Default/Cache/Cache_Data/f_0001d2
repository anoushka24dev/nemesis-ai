/* ===== Nemesis dashboard — reference-matched dark navy workspace ===== */

:root {
  --bg: #070B14;
  --surface: #0B1120;
  --sidebar: #080D18;
  --card: #0F1729;
  --card-2: #111C31;
  --panel: #0C1526;
  --border: #1B2740;
  --border-soft: #16203A;
  --text: #E9EEF9;
  --text-dim: #C2CCE0;
  --muted: #7F8AA3;
  --purple: #7C5CFC;
  --purple-dim: #5B3FE0;
  --purple-soft: rgba(124, 92, 252, 0.14);
  --green: #22C55E;
  --green-soft: rgba(34, 197, 94, 0.14);
  --blue: #3B82F6;
  --blue-soft: rgba(59, 130, 246, 0.14);
  --teal: #2DD4BF;
  --teal-soft: rgba(45, 212, 191, 0.12);
  --red: #EF4444;
  --red-soft: rgba(239, 68, 68, 0.13);
  --orange: #F97316;
  --orange-soft: rgba(249, 115, 22, 0.13);
  --white-soft: rgba(148, 163, 184, 0.12);
  --radius: 10px;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, Helvetica, Arial, sans-serif;
  font-size: 13px;
  line-height: 1.5;
  min-height: 100vh;
}

button { font: inherit; color: inherit; }

h1, h2, h3, h4 { margin: 0; font-weight: 600; letter-spacing: 0.1px; }
p { margin: 0; }

svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

.muted { color: var(--muted); }
.small { font-size: 12px; }
.fineprint { color: var(--muted); font-size: 11px; line-height: 1.55; margin-top: 8px; }
code { font-family: var(--mono); font-size: 11px; color: #A5B4FC; }

/* ---------- shell ---------- */
.app { display: flex; min-height: 100vh; }

.sidebar {
  width: 208px;
  flex: 0 0 208px;
  background: var(--sidebar);
  border-right: 1px solid var(--border-soft);
  display: flex;
  flex-direction: column;
  padding: 16px 12px 14px;
  position: sticky;
  top: 0;
  height: 100vh;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 2px 6px 20px;
}

.brand-mark {
  width: 30px; height: 30px;
  border-radius: 8px;
  display: grid; place-items: center;
  color: #C4B5FD;
  background: linear-gradient(135deg, #3B2A82, #1B1B45);
  border: 1px solid #3A2E70;
}

.brand-text h1 { font-size: 17px; letter-spacing: 0.2px; }
.brand-text span { display: block; font-size: 8.8px; color: var(--muted); letter-spacing: 0.1px; margin-top: 1px; white-space: nowrap; }

.nav { display: flex; flex-direction: column; gap: 3px; }
.nav-item {
  display: flex; align-items: center; gap: 10px;
  background: transparent; border: 1px solid transparent;
  border-radius: 8px; padding: 9px 10px;
  color: var(--text-dim); cursor: pointer;
  font-size: 12.5px; font-weight: 500; text-align: left;
}
.nav-item svg { width: 16px; height: 16px; opacity: 0.85; }
.nav-item:hover { background: rgba(255,255,255,0.03); color: var(--text); }
.nav-item.active {
  background: linear-gradient(135deg, #6D4AFF, #5B3FE0);
  border-color: #7C5CFC;
  color: #fff;
  box-shadow: 0 6px 18px rgba(109, 74, 255, 0.28);
}

.sidebar-footer {
  margin-top: auto;
  display: flex; align-items: center; gap: 9px;
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 9px;
  padding: 9px 10px;
}
.lab-mark { color: #A78BFA; }
.lab-title { font-size: 11.5px; font-weight: 600; }
.lab-sub { font-size: 10px; color: var(--muted); }

/* ---------- main ---------- */
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }

.topbar {
  height: 56px;
  display: flex; align-items: center;
  padding: 0 18px;
  border-bottom: 1px solid var(--border-soft);
  background: rgba(8, 13, 24, 0.75);
  backdrop-filter: blur(8px);
  position: sticky; top: 0; z-index: 20;
}
.topbar-spacer { flex: 1; }
.topbar-right { display: flex; align-items: center; gap: 10px; }

.model-chip {
  display: flex; align-items: center; gap: 8px;
  background: #0C1424;
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 6px 11px;
  cursor: pointer;
}
.model-chip-text { display: flex; flex-direction: column; line-height: 1.2; text-align: left; }
.model-chip strong { font-size: 11.5px; font-weight: 600; }
.model-chip small { font-size: 10px; color: var(--muted); }

.dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--muted); flex: 0 0 auto;
  display: inline-block;
}
.dot.ok { background: var(--green); box-shadow: 0 0 8px rgba(34,197,94,0.6); }
.dot.warn { background: var(--orange); box-shadow: 0 0 8px rgba(249,115,22,0.5); }
.dot.bad { background: var(--red); box-shadow: 0 0 8px rgba(239,68,68,0.5); }
.dot.live { background: var(--blue); box-shadow: 0 0 8px rgba(59,130,246,0.6); animation: pulse 1.4s infinite; }
@keyframes pulse { 50% { opacity: 0.45; } }

.icon-btn {
  background: transparent; border: 1px solid transparent;
  width: 30px; height: 30px; border-radius: 8px;
  display: grid; place-items: center; cursor: pointer; color: var(--text-dim);
}
.icon-btn:hover { background: rgba(255,255,255,0.04); color: var(--text); }

.avatar {
  width: 28px; height: 28px; border-radius: 50%;
  display: grid; place-items: center;
  font-size: 11px; font-weight: 700;
  background: #1E2A45; border: 1px solid #2B3A5C; color: #C7D2FE;
}

.content { padding: 18px 18px 40px; max-width: 1560px; width: 100%; }
.page { display: block; }
.page[hidden] { display: none; }

.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
.page-head h2 { font-size: 21px; font-weight: 700; }
.page-head p { color: var(--muted); font-size: 12px; margin-top: 3px; }

/* ---------- generic ---------- */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.card.pad { padding: 14px 16px; }
.card-title { font-size: 13px; margin-bottom: 10px; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  border: 1px solid var(--border);
  background: var(--card-2);
  color: var(--text);
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 12px; font-weight: 600;
  cursor: pointer;
  transition: filter 0.15s, background 0.15s, border-color 0.15s;
}
.btn:hover:not(:disabled) { filter: brightness(1.12); }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.btn.primary {
  background: linear-gradient(135deg, #6D4AFF, #7C5CFC);
  border-color: #8B6EFC; color: #fff;
  box-shadow: 0 6px 18px rgba(109, 74, 255, 0.25);
}
.btn.primary .plus { font-size: 15px; line-height: 1; }
.btn.danger { background: #B91C1C; border-color: #DC2626; color: #fff; }
.btn.dark { background: #0C1424; }
.btn.secondary { background: transparent; color: var(--text-dim); }

/* Prominent, always-visible Run Experiment action on the Experiments page. */
.page-actions { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.run-btn {
  padding: 9px 18px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.2px;
  box-shadow: 0 8px 22px rgba(109, 74, 255, 0.4);
}
.run-btn svg { display: inline-block; }
.btn.full { width: 100%; }
.btn.purple-outline {
  background: transparent; border-color: #4C3A96; color: #C4B5FD;
}
.link-btn {
  background: none; border: 0; color: #A78BFA; padding: 6px 0 0;
  font-size: 11.5px; font-weight: 600; cursor: pointer;
  display: inline-flex; align-items: center; gap: 5px;
}
.link-btn:hover { color: #C4B5FD; }

.pill {
  display: inline-flex; align-items: center; gap: 6px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: #0C1424;
  padding: 3px 9px;
  font-size: 10.5px; font-weight: 600; color: var(--text-dim);
}
.pill .dot { width: 6px; height: 6px; }
.pill.running { border-color: rgba(59,130,246,0.5); color: #93C5FD; background: var(--blue-soft); }
.pill.ok { border-color: rgba(34,197,94,0.45); color: #86EFAC; background: var(--green-soft); }
.pill.warn { border-color: rgba(249,115,22,0.45); color: #FDBA74; background: var(--orange-soft); }
.pill.bad { border-color: rgba(239,68,68,0.45); color: #FCA5A5; background: var(--red-soft); }
.pill.idle { color: var(--muted); }
.pill.sm { padding: 2px 7px; font-size: 10px; }
.pill.right { margin-left: auto; }

.kv-list { display: flex; flex-direction: column; gap: 7px; font-size: 12px; }
.kv-list .kv { display: flex; justify-content: space-between; gap: 12px; }
.kv-list .kv span:first-child { color: var(--muted); }
.kv-list .kv span:last-child { font-family: var(--mono); font-size: 11.5px; }

.stack { display: flex; flex-direction: column; gap: 8px; }

.code-block {
  background: #070D19;
  border: 1px solid var(--border-soft);
  border-radius: 8px;
  padding: 11px 13px;
  font-family: var(--mono);
  font-size: 11.5px;
  color: #A9B7CE;
  overflow: auto;
  max-height: 320px;
  margin: 10px 0 0;
  white-space: pre;
}

/* ---------- experiments layout ---------- */
.layout { display: grid; grid-template-columns: minmax(0, 1fr) 232px; gap: 14px; align-items: start; }
.col-main { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.col-rail { display: flex; flex-direction: column; gap: 12px; position: sticky; top: 68px; }

/* ---------- connect card ---------- */
.connect-card { padding: 16px; }

.stepper {
  display: flex; align-items: center; gap: 0;
  list-style: none; padding: 0; margin: 0 0 18px;
  font-size: 11px; color: var(--muted);
}
.stepper .step { display: flex; align-items: center; gap: 8px; flex: 1; }
.stepper .step:not(:last-child)::after {
  content: ""; flex: 1; height: 1px; background: var(--border);
  margin: 0 10px;
}
.step-num {
  width: 22px; height: 22px; border-radius: 50%;
  display: grid; place-items: center;
  border: 1px solid var(--border);
  background: #0A1220; font-size: 10.5px; font-weight: 600;
}
.stepper .step.active .step-num { background: var(--purple); border-color: #9B85FF; color: #fff; }
.stepper .step.done .step-num { background: #123021; border-color: #22C55E; color: #86EFAC; }
.stepper .step.active { color: var(--text); font-weight: 600; }

.connect-title { font-size: 15px; margin-bottom: 3px; }
.connect-sub { color: var(--muted); font-size: 11.5px; margin-bottom: 13px; }

.method-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }

.method-card {
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 14px;
  background: #0D1526;
  display: flex; flex-direction: column;
  position: relative;
  transition: border-color 0.15s, background 0.15s;
}
.method-card[data-method="http_api"] { background: linear-gradient(180deg, rgba(109,74,255,0.10), rgba(13,21,38,0.9)); }
.method-card[data-method="agent_framework"] { background: linear-gradient(180deg, rgba(45,212,191,0.06), rgba(13,21,38,0.9)); }
.method-card[data-method="agent_framework"] { opacity: 0.72; }
.method-note { font-size: 10px; color: var(--orange); margin-top: 7px; line-height: 1.45; }
.method-card.selected { border-color: #7C5CFC; box-shadow: 0 0 0 1px rgba(124,92,252,0.35) inset; }
.method-card h4 { font-size: 12.5px; margin: 9px 0 3px; }
.method-card p { font-size: 11px; color: var(--muted); min-height: 30px; }
.method-icon {
  width: 34px; height: 34px; border-radius: 50%;
  display: grid; place-items: center;
}
.method-icon svg { width: 17px; height: 17px; }
.method-icon.purple { background: #2A1F5C; color: #B9A7FF; }
.method-icon.blue { background: #102748; color: #93C5FD; }
.method-icon.teal { background: #0C2E2A; color: #7DE8DA; }

.ticks { list-style: none; padding: 0; margin: 10px 0 12px; display: flex; flex-direction: column; gap: 6px; }
.ticks li { position: relative; padding-left: 18px; font-size: 10.5px; color: var(--text-dim); line-height: 1.4; }
.ticks li::before {
  content: "✓"; position: absolute; left: 0; top: -1px;
  color: var(--green); font-size: 10.5px;
}
.ticks li.no::before { content: "×"; color: var(--orange); font-weight: 700; }

.method-btn {
  margin-top: auto; width: 100%;
  background: #111B2E; border-color: #24304C;
  font-size: 11.5px; padding: 7px 10px;
}
.method-card[data-method="http_api"] .method-btn {
  background: linear-gradient(135deg, #6D4AFF, #7C5CFC);
  border-color: #8B6EFC; color: #fff;
}
.method-btn:disabled { opacity: 0.6; }

.info-bar {
  display: flex; align-items: flex-start; gap: 8px;
  margin-top: 12px;
  background: rgba(59, 130, 246, 0.07);
  border: 1px solid rgba(59, 130, 246, 0.18);
  border-radius: 7px;
  padding: 8px 11px;
  font-size: 10.5px; color: #A9BEDA;
}
.info-i {
  width: 14px; height: 14px; border-radius: 50%;
  background: #1D4ED8; color: #fff;
  display: grid; place-items: center;
  font-size: 9px; font-weight: 700; flex: 0 0 auto; margin-top: 1px;
}

/* ---------- active experiment ---------- */
.active-card { padding: 15px 16px 14px; }
.active-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
.active-titles .title-row { display: flex; align-items: center; gap: 9px; }
.active-titles h3 { font-size: 15px; }
.active-sub, #activeSub { color: var(--muted); font-size: 11px; margin-top: 3px; }
.active-actions { display: flex; gap: 8px; }
.active-actions .btn { padding: 7px 12px; font-size: 11.5px; }
.active-actions svg { width: 13px; height: 13px; }

.stat-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 9px; margin-bottom: 13px; }
.stat {
  display: flex; align-items: center; gap: 10px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #0C1526;
  padding: 11px 12px;
}
.stat-icon {
  width: 30px; height: 30px; border-radius: 8px;
  display: grid; place-items: center; flex: 0 0 auto;
}
.stat-icon svg { width: 15px; height: 15px; }
.stat-icon.purple { background: var(--purple-soft); color: #B9A7FF; }
.stat-icon.green { background: var(--green-soft); color: #86EFAC; }
.stat-icon.blue { background: var(--blue-soft); color: #93C5FD; }
.stat-icon.red { background: var(--red-soft); color: #FCA5A5; }
.stat-icon.slate { background: var(--white-soft); color: #CBD5E1; }
.stat-label { font-size: 10px; color: var(--muted); text-transform: none; }
.stat-value { font-size: 18px; font-weight: 700; line-height: 1.15; }
.stat-value.na { font-size: 14px; color: var(--muted); }
.stat-value.green { color: #86EFAC; }
.stat-value.blue { color: #93C5FD; }
.stat-value.red { color: #FCA5A5; }
.stat-value.slate { color: #CBD5E1; }

.two-col { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr); gap: 12px; margin-bottom: 12px; }

.panel {
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #0B1424;
  padding: 11px 12px 10px;
  min-width: 0;
}
.panel-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 9px; }
.panel-head h4 { font-size: 11.5px; }
.panel-meta { font-size: 10px; color: var(--muted); }

.progress { height: 5px; background: #16223A; border-radius: 3px; overflow: hidden; }
.progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #6D4AFF, #A78BFA); border-radius: 3px; transition: width 0.3s; }
.chart-title { font-size: 10.5px; color: var(--text-dim); margin: 10px 0 4px; }
#asrChart { width: 100%; height: 200px; display: block; }
.chart-empty { font-size: 11px; color: var(--muted); padding: 24px 6px; text-align: center; }

.dim-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
.dim-item { display: grid; grid-template-columns: 16px minmax(0, 1fr) 42px; gap: 8px; align-items: center; font-size: 11px; }
.dim-item svg { width: 14px; height: 14px; color: var(--muted); }
.dim-body { min-width: 0; }
.dim-name { display: block; margin-bottom: 5px; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dim-bar { height: 4px; border-radius: 2px; background: #16223A; overflow: hidden; }
.dim-bar span { display: block; height: 100%; border-radius: 2px; }
.dim-pct { text-align: right; color: var(--text-dim); font-family: var(--mono); font-size: 10.5px; }

/* ---------- tables ---------- */
.table-scroll { overflow-x: auto; }
.table { width: 100%; border-collapse: collapse; font-size: 11px; }
.table th {
  text-align: left; font-weight: 600; color: var(--muted);
  border-bottom: 1px solid var(--border);
  padding: 6px 8px; white-space: nowrap; font-size: 10px;
}
.table td {
  padding: 7px 8px; border-bottom: 1px solid var(--border-soft);
  color: var(--text-dim); white-space: nowrap;
}
.table tr:last-child td { border-bottom: 0; }
.table td.empty { text-align: center; color: var(--muted); padding: 18px; white-space: normal; }
.table code { color: #A5B4FC; }

.badge {
  display: inline-block; padding: 2px 7px; border-radius: 999px;
  font-size: 9.5px; font-weight: 600; border: 1px solid transparent;
}
.badge.green { background: var(--green-soft); color: #86EFAC; border-color: rgba(34,197,94,0.35); }
.badge.blue { background: var(--blue-soft); color: #93C5FD; border-color: rgba(59,130,246,0.35); }
.badge.red { background: var(--red-soft); color: #FCA5A5; border-color: rgba(239,68,68,0.35); }
.badge.slate { background: var(--white-soft); color: #CBD5E1; border-color: #334155; }
.badge.orange { background: var(--orange-soft); color: #FDBA74; border-color: rgba(249,115,22,0.35); }
.badge.purple { background: var(--purple-soft); color: #C4B5FD; border-color: rgba(124,92,252,0.4); }

/* ---------- activity ---------- */
.activity { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 11px; }
.act-item { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 8px; align-items: start; }
.act-icon {
  width: 21px; height: 21px; border-radius: 50%;
  display: grid; place-items: center;
  background: #16223A; color: #CBD5E1;
}
.act-icon svg { width: 11px; height: 11px; }
.act-icon.purple { background: var(--purple-soft); color: #C4B5FD; }
.act-icon.green { background: var(--green-soft); color: #86EFAC; }
.act-icon.blue { background: var(--blue-soft); color: #93C5FD; }
.act-icon.orange { background: var(--orange-soft); color: #FDBA74; }
.act-title { font-size: 11px; color: var(--text); font-weight: 600; }
.act-detail { font-size: 10px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.act-time { font-size: 9.5px; color: var(--muted); white-space: nowrap; padding-top: 2px; }

/* ---------- right rail ---------- */
.rail-card { padding: 11px 12px; }
.rail-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.rail-card h4 { font-size: 11.5px; margin-bottom: 9px; }
.rail-head h4 { margin-bottom: 0; }

.agent-tile {
  display: flex; align-items: center; gap: 9px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0C1526;
  padding: 9px 10px;
  margin-bottom: 9px;
}
.agent-avatar {
  width: 30px; height: 30px; border-radius: 8px;
  background: #16223A; color: #B9A7FF;
  display: grid; place-items: center; flex: 0 0 auto;
}
.agent-avatar.model { color: #7DE8DA; }
.agent-name { font-size: 11px; font-weight: 600; }
.agent-kind { font-size: 10px; color: var(--muted); }
.rail-card .btn { font-size: 11px; padding: 7px 10px; }

.rail-note { font-size: 10px; color: var(--muted); line-height: 1.45; }
.rail-note.error { color: #FCA5A5; }

.objective-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; }
.objective-list li { display: flex; align-items: center; gap: 8px; font-size: 10.5px; color: var(--text-dim); }
.obj-check {
  width: 13px; height: 13px; border-radius: 50%;
  display: grid; place-items: center; flex: 0 0 auto;
  background: var(--green-soft); color: #86EFAC;
  font-size: 8.5px; font-weight: 700;
}

.settings-list { margin: 0; display: flex; flex-direction: column; gap: 8px; }
.settings-list > div { display: flex; justify-content: space-between; align-items: baseline; font-size: 10.5px; }
.settings-list dt { color: var(--muted); }
.settings-list dd { margin: 0; color: var(--text-dim); font-weight: 600; font-size: 10.5px; }

.reports-card { background: linear-gradient(180deg, rgba(76,58,150,0.28), rgba(11,17,32,0.9)); border-color: #3A2E70; }
.reports-card p { font-size: 10px; color: #B7A9E8; margin-bottom: 10px; }
.reports-card .btn { justify-content: space-between; }

/* ---------- agents page ---------- */
.agents-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-bottom: 14px; }
.agent-method { padding: 14px; display: flex; flex-direction: column; gap: 10px; }
.agent-method-head { display: flex; align-items: center; gap: 10px; }
.agent-method-head h3 { font-size: 13px; }
.agent-method-head p { font-size: 10.5px; color: var(--muted); }
.agent-method .form-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.agent-method label { font-size: 10px; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
.agent-method input { width: 100%; }
.status-line { font-size: 10.5px; color: var(--muted); display: flex; gap: 6px; align-items: center; }
.agent-method-actions { display: flex; gap: 6px; margin-top: auto; }
.agent-method-actions .btn { flex: 1; font-size: 11px; padding: 7px 8px; }
.agent-method.unavailable { opacity: 0.8; border-style: dashed; }
.agent-method.unavailable input { cursor: not-allowed; }
.unavailable-note {
  margin-top: auto;
  border: 1px solid rgba(249, 115, 22, 0.28);
  background: var(--orange-soft);
  color: #FDBA74;
  border-radius: 7px;
  padding: 8px 10px;
  font-size: 10.5px;
  line-height: 1.5;
}
.agent-method.highlight { border-color: #7C5CFC; box-shadow: 0 0 0 1px rgba(124,92,252,0.45) inset; }
.field-hint { display: block; font-size: 9.5px; color: var(--muted); line-height: 1.4; margin-top: 4px; }

input, select {
  background: #0A1220;
  border: 1px solid var(--border);
  border-radius: 7px;
  color: var(--text);
  padding: 7px 9px;
  font: inherit;
  font-size: 11.5px;
  outline: none;
}
input:focus, select:focus { border-color: #5B3FE0; }
input::placeholder { color: #55617A; }

/* ---------- defenses ---------- */
.barrier {
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #0C1526;
  padding: 9px 11px;
  font-size: 11px;
  color: var(--text-dim);
  margin-bottom: 12px;
}
.barrier.ok { border-color: rgba(34,197,94,0.4); background: rgba(34,197,94,0.06); }
.barrier.blocked { border-color: rgba(249,115,22,0.4); background: rgba(249,115,22,0.06); }
.defense-controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-bottom: 12px; }
.defense-controls label { display: flex; flex-direction: column; gap: 4px; font-size: 10px; color: var(--muted); }
.defense-controls select { min-width: 220px; }
.defense-result { border-top: 1px solid var(--border-soft); padding-top: 10px; line-height: 1.6; }
.defense-result .line { font-size: 11px; color: var(--text-dim); }
.defense-result .limit { font-size: 10.5px; color: var(--muted); }
.defense-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin: 14px 0; }
.defense-card { padding: 13px; }
.defense-card h4 { font-size: 12px; margin-bottom: 4px; }
.defense-card .meta { font-size: 10px; color: var(--muted); margin-bottom: 8px; }
.defense-card p { font-size: 10.5px; color: var(--text-dim); margin-bottom: 6px; }
.defense-card .limits { font-size: 10px; color: #FDBA74; }

/* ---------- settings/home ---------- */
.settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
.home-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
.act-dot {
  width: 7px; height: 7px; border-radius: 50%;
  margin-top: 5px; justify-self: center;
  background: var(--muted); flex: 0 0 auto;
}
.act-dot.purple { background: var(--purple); }
.act-dot.blue { background: var(--blue); }
.act-dot.green { background: var(--green); }

/* ---------- modals ---------- */
.modal-backdrop {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(3, 6, 12, 0.72);
  display: grid; place-items: center;
  padding: 20px;
}
.modal-backdrop[hidden] { display: none; }
.modal {
  width: min(520px, 100%);
  background: #0C1424;
  border: 1px solid #24304C;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 24px 60px rgba(0,0,0,0.5);
  max-height: 90vh;
  overflow: auto;
}
.modal.wide { width: min(680px, 100%); }
.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.modal-head h3 { font-size: 15px; }
.modal-sub { font-size: 11px; color: var(--muted); margin-bottom: 12px; }
.form-grid { display: grid; gap: 9px; margin-bottom: 10px; }
.form-grid.two { grid-template-columns: 1fr 1fr; }
.form-grid label { display: flex; flex-direction: column; gap: 4px; font-size: 10.5px; color: var(--muted); }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
.target-line {
  font-size: 10.5px; color: var(--text-dim);
  background: #0A1220; border: 1px solid var(--border-soft);
  border-radius: 7px; padding: 8px 10px;
}
.probe-result { margin-top: 10px; border-radius: 7px; padding: 9px 11px; font-size: 11px; line-height: 1.6; }
.probe-result.ok { background: rgba(34,197,94,0.08); border: 1px solid rgba(34,197,94,0.35); color: #BBF7D0; }
.probe-result.bad { background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.35); color: #FECACA; }

.toast {
  position: fixed; bottom: 18px; right: 18px; z-index: 200;
  background: #0C1424; border: 1px solid #24304C;
  border-radius: 8px; padding: 10px 14px; font-size: 11.5px;
  box-shadow: 0 12px 30px rgba(0,0,0,0.4);
  max-width: 420px;
}
.toast[hidden] { display: none; }
.toast.bad { border-color: rgba(239,68,68,0.5); color: #FECACA; }

/* ---------- responsive ---------- */
@media (max-width: 1180px) {
  .layout { grid-template-columns: minmax(0, 1fr); }
  .col-rail { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 900px) {
  .sidebar { display: none; }
  .method-grid { grid-template-columns: 1fr; }
  .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .two-col { grid-template-columns: 1fr; }
  .col-rail { grid-template-columns: 1fr; }
  .form-grid.two { grid-template-columns: 1fr; }
}

/* ---------- defense campaign / case selection ---------- */
.defense-case-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 14px 0 8px; font-size: 11px; color: var(--text-dim); }
.defense-case-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.case-select-list { display: grid; gap: 6px; max-height: 300px; overflow: auto; border: 1px solid var(--border-soft); border-radius: 10px; padding: 8px; background: rgba(255,255,255,0.01); }
.case-choice { display: flex; gap: 9px; align-items: flex-start; padding: 7px 8px; border-radius: 8px; font-size: 11px; }
.case-choice:hover { background: rgba(139,124,246,0.07); }
.case-choice input { margin-top: 2px; }
.case-choice.ineligible { opacity: 0.55; }
.case-choice .case-id { font-family: var(--mono, monospace); color: var(--text); }
.case-choice .case-why { color: #FDBA74; font-size: 10px; }
.case-choice .case-meta { color: var(--muted); font-size: 10px; }
