function renderReports(o) {
  const body = $("runTableBody");
  const runs = (o.reports?.runs || []).slice().reverse();
  body.innerHTML = runs.length
    ? runs.map((r) => `<tr>
        <td><code>${esc(r.run_id)}</code></td>
        <td>${statusBadge(r.status)}</td>
