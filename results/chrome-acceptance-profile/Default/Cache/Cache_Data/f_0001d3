function renderAgents(o) {
  const host = $("agentMethodList");
  if (!host) return;
  const connections = o.connections || [];
  host.innerHTML = connections.map((c) => {
    const unavailable = c.status !== "available";
    const fields = (c.fields || []).map((f) => {
