  const latest = o.candidates || [];
  const cases = latest.flatMap((c) => (c.cases || []).map((k) => ({ ...k, candidate: c.candidate_id, objective: c.objective })));
  $("casesMeta").textContent = cases.length
    ? `${cases.length} case(s) from the displayed candidates · ${cases.filter((c) => c.bucket === "success").length} successful`
