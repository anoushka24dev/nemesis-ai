{
  "manifest_version": 3,
  "name": "Nemesis Autonomous Email Agent",
  "version": "0.1.0",
  "description": "Nemesis autonomous Gmail agent: read-only analysis plus policy-enforced send/reply/forward in simulation mode by default. Live transport stays disabled unless the owner arms it separately. No approval buttons.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:8123/*",
    "http://localhost:8123/*",
    "https://mail.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Open RealGmail read-only sidebar" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
