[TEMPLATE]
# ==========================================
# Adaptive AI Agent Defense Evaluation Framework
# Environment variables — copy to .env and edit
# ==========================================

# ---- LLM Provider (default: OpenAI) ----
# Choose exactly one provider. OpenAI is the default (no GPU, hosted API).
# Anthropic is an alternative.
# The active provider is picked up from LLM_PROVIDER if set; otherwise OpenAI.

# OpenAI (RECOMMENDED — free tier typically available)
OPENAI_API_KEY=sk-...
# Default model used when no per-role override is set.
OPENAI_MODEL=gpt-4o-mini
# Per-role model names (optional; falls back to OPENAI_MODEL / provider defaults).
OPENAI_MODEL_ATTACKER=gpt-4o-mini
OPENAI_MODEL_ATTACKER_FRONTIER=gpt-4o
OPENAI_MODEL_TARGET=gpt-4o-mini
OPENAI_MODEL_TARGET_FRONTIER=gpt-4o
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241026
# ANTHROPIC_MODEL_ATTACKER=claude-3-5-haiku-20241026
# ANTHROPIC_MODEL_ATTACKER_FRONTIER=claude-opus-4-6
# ANTHROPIC_MODEL_TARGET=claude-3-5-haiku-20241026
# ANTHROPIC_MODEL_TARGET_FRONTIER=claude-opus-4-6
# ANTHROPIC_MODEL_CLASSIFIER=claude-3-5-haiku-20241026

# ---- Provider overrides (optional) ----
# LLM_PROVIDER=openai
# LLM_API_BASE=https://api.example.com/v1
# LLM_TIMEOUT_SECONDS=60
# LLM_RETRIES=3
# LLM_RETRY_BASE_DELAY=1.0
# LLM_PROVIDER_MODEL_MAP=false  # set only if you want to bypass provider-native model translation

# ---- Experiment Defaults ----
DEFAULT_MODE=single-agent
DEFAULT_EPISODES_PER_CONFIG=50
DEFAULT_MAX_ROUNDS=5
DEFAULT_DEFENSES=camel
DEFAULT_ATTACKER_TIERS=cheap
DEFAULT_TARGET_TIERS=cheap

# ---- Memory / Persistence ----
MEMORY_PERSIST_DIR=data/episodes

# ---- Observability ----
LOG_LEVEL=INFO
RESULT_DIR=results

# ---- Phase 3: Gmail OAuth + Gemini analysis (gmail_auth.py) ----
# Gmail scope is hardcoded to gmail.readonly (read-only: no send / forward /
# delete / modify). token.json is written on the first `python gmail_auth.py` run.

# Gemini API key — used through ProviderConfig against Gemini's
# OpenAI-compatible endpoint. (GOOGLE_API_KEY is accepted as a fallback.)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.8-flash

# Keep the Phase 1/2 demo protections active during analysis:
# EMAIL_DEMO_MODE=true

# ---- Nemesis outbound Gmail workflow (owner authorization) ----
# The durable outbound stop defaults ON and blocks every real send/draft.
# Preparation and local simulation work while it is ON; releasing it requires
# an explicit confirm=true request and does NOT arm or authorize sending.
# NEMESIS_WORKFLOW_MODE=simulation
# NEMESIS_ALLOWED_RECIPIENTS=owner-approved@example.com
# NEMESIS_ALLOWED_DOMAINS=
# NEMESIS_SEND_AUTHORIZED=0
# NEMESIS_DRAFT_AUTHORIZED=0
# NEMESIS_GRANTED_SCOPES=readonly
# NEMESIS_RATE_LIMIT_PER_HOUR=5
# NEMESIS_OUTBOUND_STATE_PATH=results/nemesis_outbound_state.sqlite3
#
# Live sending additionally requires ALL of: the exact consent phrase in
# NEMESIS_LIVE_SEND_CONSENT, a separate write OAuth client, and a
# scope-validated write token minted with `python -m gmail_live auth`.
# Never commit real credentials, tokens, or recipient addresses.

# ---- Multi-tenancy (v1 — planned) ----
# TENANT_EMAIL=
# ACCOUNT_ID=
# ORG_NAME=
# WORKSPACE_ID=
